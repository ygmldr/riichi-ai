+# [patch 0007] token vocabularies, one per column of the (T, 5) token stream
+# produced by `libriichi/src/mjai/tokens.rs` / `event_data.collate_events`:
+# (type_id <= 19, tile <= 34, actor <= 4, turn, flags) with 34/4 = "none" and
+# `turn` = POV tsumo count so far (bounded by the event count).
+EVENT_TYPE_VOCAB = 20
+EVENT_TILE_VOCAB = 35
+EVENT_ACTOR_VOCAB = 5
+EVENT_TURN_VOCAB = MAX_EVENT_TOKENS + 1
+EVENT_FLAGS_VOCAB = 8
+
+class EventBranch(nn.Module):
+    """[patch 0007] public event-stream Transformer (E3a treatment arm).
+
+    Consumes the `collate_events` batch (patches 0006/0010) and returns the
+    1024-d residual delta that `Brain.forward` adds to the CNN embedding. The
+    output projection is zero-initialised, so an untrained branch is exactly
+    the identity (`phi_out == phi` bit-for-bit) and the CNN-only path is
+    untouched until the branch has received gradient.
+
+    Attention is causal: a decision point only sees events up to and including
+    its trigger. Padded tokens are inconsequential because no real position can
+    attend to a later padding token and the pooled output is read at the last
+    real token.
+    """
+
+    def __init__(self, *, dim=128, heads=4, layers=4, ffn=512, out_dim=1024):
+        super().__init__()
+        assert dim % heads == 0, f'event_dim {dim} not divisible by event_heads {heads}'
+        self.dim = dim
+        self.embeds = nn.ModuleList([
+            nn.Embedding(EVENT_TYPE_VOCAB, dim),
+            nn.Embedding(EVENT_TILE_VOCAB, dim),
+            nn.Embedding(EVENT_ACTOR_VOCAB, dim),
+            nn.Embedding(EVENT_TURN_VOCAB, dim),
+            nn.Embedding(EVENT_FLAGS_VOCAB, dim),
+        ])
+        self.pos_embed = nn.Embedding(MAX_EVENT_TOKENS, dim)
+        self.layers = nn.ModuleList([
+            nn.TransformerEncoderLayer(
+                d_model = dim,
+                nhead = heads,
+                dim_feedforward = ffn,
+                dropout = 0.0,
+                batch_first = True,
+            )
+            for _ in range(layers)
+        ])
+        self.proj = nn.Linear(dim, out_dim, bias=False)
+        nn.init.zeros_(self.proj.weight)
+
+    def forward(self, events) -> Tensor:
+        tokens = events['tokens'].long()    # (B, T, 5)
+        lengths = events['lengths']         # (B,)
+        x = self.embeds[0](tokens[..., 0])
+        x = x + self.embeds[1](tokens[..., 1])
+        x = x + self.embeds[2](tokens[..., 2])
+        x = x + self.embeds[3](tokens[..., 3])
+        x = x + self.embeds[4](tokens[..., 4])
+        seq_len = x.shape[1]
+        pos = torch.arange(seq_len, device=x.device)
+        x = x + self.pos_embed(pos)
+        # `src_mask` marks positions that are *disallowed* (True == masked
+        # out), so the strictly upper triangle is the causal mask. Padding is
+        # deliberately *not* masked: causal attention means no real position
+        # can see a later padding token, and the pooled output is read at the
+        # last real token, so padded tokens cannot influence the result
+        # (asserted in `scripts/exp_e3a_selfcheck.py`); dropping
+        # `src_key_padding_mask` keeps attention on the fast path.
+        causal = torch.triu(
+            torch.ones(seq_len, seq_len, dtype=torch.bool, device=x.device),
+            diagonal=1,
+        )
+        for layer in self.layers:
+            x = layer(x, src_mask=causal)
+        idx = (lengths - 1).clamp(min=0).to(x.device)
+        h = x[torch.arange(x.shape[0], device=x.device), idx]
+        return self.proj(h)
+
