+def has_event_branch_weights(state_dict) -> bool:
+    return any(k.startswith('event_branch.') for k in state_dict)
+
+def brain_from_config(cfg, *, is_oracle=False) -> Brain:
+    """[patch 0007] build a `Brain` from a saved config (`state['config']`).
+
+    The `[model]` section (toggle + hyper-parameters) is read from the config
+    that the checkpoint itself carries, never from the process's live config:
+    an old CNN checkpoint therefore always resolves to a branch-less Brain even
+    when the live config enables the branch (plan decision #10).
+    """
+    return Brain(
+        version = cfg['control'].get('version', 1),
+        conv_channels = cfg['resnet']['conv_channels'],
+        num_blocks = cfg['resnet']['num_blocks'],
+        is_oracle = is_oracle,
+        **cfg.get('model', {}),
+    )
+
+def load_brain_state_dict(mortal, state_dict, *, source='checkpoint'):
+    """[patch 0007] `strict=False` load guarded against silent degradation.
+
+    E3a checkpoints carry `event_branch.*` weights. Loading them into a
+    branch-less Brain with `strict=False` would drop them without a trace and
+    the arm would evaluate as the E2 CNN-only arm -- a false "no difference"
+    verdict. Refuse loudly instead (plan decision #10).
+    """
+    if has_event_branch_weights(state_dict) and getattr(mortal, 'event_branch', None) is None:
+        raise RuntimeError(
+            f'{source}: checkpoint contains event-branch weights but the constructed '
+            'Brain has use_event_branch=false; refusing to drop them silently '
+            '(strict=False would degrade E3a into E2)'
+        )
+    incompatible = mortal.load_state_dict(state_dict, strict=False)
+    if incompatible.unexpected_keys:
+        raise RuntimeError(
+            f'{source}: unexpected keys while loading Brain: '
+            f'{incompatible.unexpected_keys[:8]}'
+        )
+    if incompatible.missing_keys:
+        logging.warning(
+            f'{source}: missing keys while loading Brain (kept at init): '
+            f'{incompatible.missing_keys[:8]}'
+        )
+    return incompatible
+
