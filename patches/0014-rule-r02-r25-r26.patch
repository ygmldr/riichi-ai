+        let mut state = board_state();
+        let reactions = [hora(0, 3), hora(1, 3), hora(2, 3), EventExt::default()];
+
+        state.handle_hora(0, 3, &reactions).unwrap();
+
+        assert!(state.has_abortive_ryukyoku);
+        assert!(!state.has_hora);
+        assert_eq!(state.kyoku_deltas, [0; 4]);
+        assert_eq!(state.board.scores, [19500, 23500, 30500, 22500]);
+        assert_eq!(state.board.kyotaku, 4);
+        assert!(state
+            .log
+            .iter()
+            .any(|ev| matches!(&ev.event, Event::Ryukyoku { deltas: Some([0, 0, 0, 0]) })));
+
+        let result = state.end();
+        assert!(!result.has_hora);
+        assert!(result.has_abortive_ryukyoku);
+        assert_eq!(result.kyotaku_left, 4);
+        assert_eq!(result.scores, [19500, 23500, 30500, 22500]);
+    }
+
+    #[test]
+    fn r26_fourth_riichi_aborts_before_the_next_draw() {
+        let mut state = board_state();
+        state.tiles_left = 10;
+        state.board.yama.truncate(10);
+        state.accepted_riichis = 3;
+        state.tsumo_actor = 0;
+        state.riichi_to_be_accepted = Some(0);
+
+        let poll = state.poll(std::array::from_fn(|_| EventExt::default())).unwrap();
+
+        assert!(matches!(poll, Poll::End));
+        assert!(state.has_abortive_ryukyoku);
+        assert!(state.can_renchan);
+        assert_eq!(state.accepted_riichis, 4);
+        assert_eq!(state.tiles_left, 10);
+        assert_eq!(state.board.yama.len(), 10);
+        assert_eq!(state.board.scores[0], 18500);
+        assert_eq!(state.board.kyotaku, 5);
+
+        let reach = state
+            .log
+            .iter()
+            .position(|ev| matches!(&ev.event, Event::ReachAccepted { actor: 0 }))
+            .expect("the fourth riichi must be accepted before the abort");
+        assert!(
+            state.log[reach + 1..]
+                .iter()
+                .all(|ev| !matches!(&ev.event, Event::Tsumo { .. })),
+            "no tile may be drawn after the fourth riichi is accepted"
+        );
+        assert!(matches!(
+            state.log.last().map(|ev| &ev.event),
+            Some(Event::EndKyoku)
+        ));
+        assert_eq!(state.end().kyotaku_left, 5);
+    }
+}
