+            honba: 2,
+            kyotaku: 4,
+            scores: [19500, 23500, 30500, 22500],
+            haipai: [[t!(1m); 13]; 4],
+            yama: vec![t!(9s); 70],
+            rinshan: vec![t!(9s); 4],
