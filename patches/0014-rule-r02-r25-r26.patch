+#[cfg(test)]
+mod rule_tests {
+    use super::*;
+
+    fn result(scores: [i32; 4], kyotaku_paid: u8, winner: Option<u8>) -> KyokuResult {
+        KyokuResult {
+            kyoku: 7,
+            can_renchan: true,
+            has_hora: true,
+            has_abortive_ryukyoku: false,
+            kyotaku_left: 0,
+            kyotaku_paid,
+            kyotaku_winner: winner,
+            scores,
+        }
+    }
+
+    #[test]
+    fn r25_last_dealer_stop_excludes_just_paid_kyotaku() {
+        // S4 is kyoku 7 -> oya is absolute seat 3 (E1 dealer is seat 0).
+        // The raw score includes the 4 kyotaku (4000) paid to oya.
+        let fx = result([19000, 19000, 29000, 33000], 4, Some(3));
+        assert_eq!(
+            fx.scores_excluding_hora_kyotaku(),
+            [19000, 19000, 29000, 29000]
+        );
+        assert!(
+            !last_dealer_stop(8, &fx),
+            "33000 includes 4000 kyotaku; 29000 < 30000"
+        );
+
+        // The old, kyotaku-inclusive comparison would have stopped the game.
+        let raw = fx.scores;
+        assert!(raw[3] >= 30000);
+        assert_eq!(
+            raw.iter()
+                .enumerate()
+                .min_by_key(|&(_, &s)| -s)
+                .map(|(i, _)| i),
+            Some(3)
+        );
+
+        // A genuine 30000+ after excluding the payout still stops.
+        let fx = result([19000, 19000, 28000, 34000], 4, Some(3));
+        assert_eq!(
+            fx.scores_excluding_hora_kyotaku(),
+            [19000, 19000, 28000, 30000]
+        );
+        assert!(last_dealer_stop(8, &fx));
+
+        // A non-dealer payout is removed from the winner, not from the dealer.
+        let fx = result([19000, 19000, 29000, 33000], 4, Some(1));
+        assert_eq!(
+            fx.scores_excluding_hora_kyotaku(),
+            [19000, 15000, 29000, 33000]
+        );
+        assert!(last_dealer_stop(8, &fx));
+
+        // Not all-last: never stop early.
+        let mut fx = result([20000, 20000, 40000, 20000], 0, None);
+        fx.kyoku = 6;
+        assert!(!last_dealer_stop(8, &fx));
+    }
+}
diff --git a/libriichi/src/arena/result.rs b/libriichi/src/arena/result.rs
index 452bb3c..85ec2bf 100644
--- a/libriichi/src/arena/result.rs
+++ b/libriichi/src/arena/result.rs
@@ -12,9 +12,29 @@ pub struct KyokuResult {
     pub has_hora: bool,
     pub has_abortive_ryukyoku: bool,
     pub kyotaku_left: u8,
+    /// Number of riichi sticks paid out by a hora in this kyoku.
+    pub kyotaku_paid: u8,
+    /// Winner who received the paid riichi sticks, if any.
+    pub kyotaku_winner: Option<u8>,
     pub scores: [i32; 4],
 }
 
+impl KyokuResult {
+    /// Scores with the just-paid kyotaku removed.
+    ///
+    /// Tenhou's last-dealer 和了止め / 聴牌止め compares scores after settlement
+    /// but 供託料を除く (<https://tenhou.net/man/#RULE>). `scores` already include
+    /// the payout because `board.rs` adds it to the winning hand's deltas.
+    #[must_use]
+    pub fn scores_excluding_hora_kyotaku(&self) -> [i32; 4] {
+        let mut scores = self.scores;
+        if let Some(winner) = self.kyotaku_winner {
+            scores[winner as usize] -= self.kyotaku_paid as i32 * 1000;
+        }
+        scores
+    }
+}
