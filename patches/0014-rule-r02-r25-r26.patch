+/// Tenhou's last-dealer 和了止め / 聴牌止め check.
+///
+/// The comparison is made after settlement but excludes the kyotaku paid by
+/// this hand (`供託料を除く`). The final scores keep the payout; only this
+/// decision uses the adjusted vector.
+fn last_dealer_stop(length: u8, kyoku_result: &KyokuResult) -> bool {
+    if kyoku_result.kyoku < length - 1 {
+        return false;
+    }
+    let oya = kyoku_result.kyoku as usize % 4;
+    let scores = kyoku_result.scores_excluding_hora_kyotaku();
+    if scores[oya] < 30000 {
+        return false;
+    }
+    scores
+        .iter()
+        .enumerate()
+        .min_by_key(|&(_, &s)| -s)
+        .map(|(i, _)| i)
+        == Some(oya)
