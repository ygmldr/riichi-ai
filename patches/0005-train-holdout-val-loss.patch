+                            loss = sum((
+                                dqn_loss,
+                                cql_loss * min_q_weight,
+                                next_rank_loss * next_rank_weight,
+                            ))
+                        totals[0] += loss.item()
+                        totals[1] += dqn_loss.item()
+                        totals[2] += cql_loss.item()
+                        totals[3] += next_rank_loss.item()
+                        n += 1
