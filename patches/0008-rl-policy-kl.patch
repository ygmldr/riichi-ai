+import logging
+from typing import Optional, Tuple
+
+import torch
+from torch import Tensor
+from torch.nn import functional as F
+
+# [patch 0008] RL objective for online self-play (plan todo 23):
+#
+#   loss = dqn_loss + cql_loss * min_q_weight + next_rank_loss * next_rank_weight
+#          + pg_loss + lam_v * huber(v, G) + lam_kl * KL(pi_anchor || pi)
+#
+# `use_pg` is the master switch owned by train.py: while it is false the three
+# terms below are all exactly zero, so the training loss stays bit-for-bit the
+# pre-0008 loss (the parity the earlier arm verdicts depend on). `G` is the
+# Monte-Carlo return `gamma ** steps_to_done * kyoku_rewards`.
+
+def reinforce_loss(q_out: Tensor, actions: Tensor, returns: Tensor, v: Tensor) -> Tensor:
+    logp = torch.log_softmax(q_out, dim=-1)
+    advantage = returns - v.reshape(-1).detach()
+    return -(logp.gather(1, actions.unsqueeze(1)).squeeze(1) * advantage).mean()
+
+def value_huber_loss(v: Tensor, returns: Tensor, lam_v: float) -> Tensor:
+    return lam_v * F.smooth_l1_loss(v.reshape(-1).float(), returns.float())
+
+def forward_kl_loss(
+    anchor_q: Tensor,
+    q_out: Tensor,
+    masks: Tensor,
+    *,
+    anchor_desc: str = '',
+) -> Tensor:
+    logp = torch.log_softmax(q_out, dim=-1)
+    logp_anchor = torch.log_softmax(anchor_q, dim=-1)
+    p_anchor = logp_anchor.exp()
+    kl = (p_anchor * (logp_anchor - logp)).masked_fill(~masks, 0.).sum(-1).mean()
+    if not torch.isfinite(kl):
+        logging.error(
+            f'KL(pi_anchor || pi) is not finite: pi_anchor {tuple(p_anchor.shape)}, '
+            f'pi {tuple(logp.shape)}, anchor {anchor_desc}'
+        )
+        raise SystemExit(1)
+    return kl
+
+def rl_loss_terms(
+    *,
+    q_out: Tensor,
+    v: Tensor,
+    actions: Tensor,
+    returns: Tensor,
+    masks: Tensor,
+    use_pg: bool,
+    lam_v: float,
+    lam_kl: float,
+    anchor_q: Optional[Tensor] = None,
+    anchor_desc: str = '',
+) -> Tuple[Tensor, Tensor, Tensor]:
+    if not use_pg:
+        zero = q_out.new_zeros(())
+        return zero, zero, zero
+    pg_loss = reinforce_loss(q_out, actions, returns, v)
+    v_loss = value_huber_loss(v, returns, lam_v)
+    kl_loss = q_out.new_zeros(())
+    if lam_kl > 0:
+        if anchor_q is None:
+            raise RuntimeError(
+                f'lam_kl={lam_kl} > 0 but anchor_q is None; the KL anchor must be loaded '
+                '(anchor ' + anchor_desc + ')'
+            )
+        kl_loss = lam_kl * forward_kl_loss(anchor_q, q_out, masks, anchor_desc=anchor_desc)
+    return pg_loss, v_loss, kl_loss
