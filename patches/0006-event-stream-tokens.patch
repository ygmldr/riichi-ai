diff --git a/mortal/event_data.py b/mortal/event_data.py
new file mode 100644
index 0000000..ffa24e8
--- /dev/null
+++ b/mortal/event_data.py
@@ -0,0 +1,33 @@
+import torch
+
+EVENT_TOKEN_DIM = 5
+MAX_EVENT_TOKENS = 384
+
+# Batch layout produced by `collate_events`:
+#   tokens: (B, T, 5) int16, zero padded (type id 0 == none/padding)
+#   lengths: (B,) int64, number of public events per decision point
+#   mask: (B, T) bool, valid (non-padding) positions
+#   causal: (T, T) bool lower-triangular, the causal attention mask
+def collate_events(events):
+    batch_size = len(events)
+    lengths = torch.tensor([len(e) for e in events], dtype=torch.int64)
+    seq_len = int(lengths.max().item()) if batch_size > 0 else 0
+    seq_len = max(seq_len, 1)
+    tokens = torch.zeros((batch_size, seq_len, EVENT_TOKEN_DIM), dtype=torch.int16)
+    mask = torch.zeros((batch_size, seq_len), dtype=torch.bool)
+    for i, e in enumerate(events):
+        t = len(e)
+        if t > 0:
+            tokens[i, :t] = torch.as_tensor(e, dtype=torch.int16)
+            mask[i, :t] = True
+    causal = torch.ones((seq_len, seq_len), dtype=torch.bool).tril()
+    return {'tokens': tokens, 'lengths': lengths, 'mask': mask, 'causal': causal}
+
+
+def cat_event_batches(batches):
+    keys = batches[0].keys()
+    return {k: torch.cat([b[k] for b in batches], dim=0) for k in keys}
+
+
+def slice_event_batch(batch, start, end):
+    return {k: v[start:end] for k, v in batch.items()}
