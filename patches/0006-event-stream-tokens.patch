index 0000000..a3bab09
--- /dev/null
+++ b/libriichi/src/mjai/tokens.rs
@@ -0,0 +1,250 @@
+//! [patch 0006] Public event-stream tokenizer.
+//!
+//! This module is the single source of truth for the event-token spec used by
+//! BOTH the dataset path (`dataset/gameplay.rs`) and the arena/eval path
+//! (`agent/mortal.rs`, patch 0010). Keeping one encoder here guarantees that a
+//! sequence produced from a raw mjai log and a sequence produced from the live
+//! arena board are byte-identical for the same decision point.
+//!
+//! Token spec: shape `(T, 5)`, dtype `i16`, columns
+//! `(type_id, tile, actor, turn, flags)`.
+//! - `type_id`: mjai event variant id, 0..=16 (all <= 19).
+//! - `tile`: `deaka()` tile id 0..=33, or 34 when the event has no tile.
+//! - `actor`: absolute seat 0..=3, or 4 when the event has no actor.
+//! - `turn` (POV-relative): number of `Tsumo` events drawn by the POV player so
+//!   far in the current kyoku, *including* the current event when it is a POV
+//!   tsumo. This is exactly `PlayerState::at_turn()` after the event, but it is
+//!   derived from the event stream alone so the arena (which only has the
+//!   shared kyoku log, not per-event historical states) can reproduce it.
+//! - `flags`: bit 0 = the event's representative tile is aka dora;
+//!   bit 1 = `dahai` was tsumogiri; bit 2 = a `consumed` tile is aka.
+//!
+//! `T <= MAX_EVENT_TOKENS` (384). One kyoku contains at most ~200 public
+//! events (70 live-wall draws plus calls/dora/riichi), so the cap is a hard
+//! safety bound, not a truncation that occurs in practice.
+//!
+//! No hidden information ever enters the stream: `StartKyoku` only emits the
+//! public dora marker (never `tehais`), and no event carries another player's
+//! hand, wall, or ura markers.
+
+use crate::mjai::{Event, EventExt};
+use crate::tile::Tile;
+
+use ndarray::prelude::*;
+
+pub const EVENT_TOKEN_DIM: usize = 5;
+pub const MAX_EVENT_TOKENS: usize = 384;
+
+pub const TILE_NONE: i16 = 34;
+pub const ACTOR_NONE: i16 = 4;
+
+pub const TYPE_NONE: i16 = 0;
+pub const TYPE_START_GAME: i16 = 1;
+pub const TYPE_START_KYOKU: i16 = 2;
+pub const TYPE_TSUMO: i16 = 3;
+pub const TYPE_DAHAI: i16 = 4;
+pub const TYPE_CHI: i16 = 5;
+pub const TYPE_PON: i16 = 6;
+pub const TYPE_DAIMINKAN: i16 = 7;
+pub const TYPE_KAKAN: i16 = 8;
+pub const TYPE_ANKAN: i16 = 9;
+pub const TYPE_DORA: i16 = 10;
+pub const TYPE_REACH: i16 = 11;
+pub const TYPE_REACH_ACCEPTED: i16 = 12;
+pub const TYPE_HORA: i16 = 13;
+pub const TYPE_RYUKYOKU: i16 = 14;
+pub const TYPE_END_KYOKU: i16 = 15;
+pub const TYPE_END_GAME: i16 = 16;
+
+pub const FLAG_AKA: i16 = 1 << 0;
+pub const FLAG_TSUMOGIRI: i16 = 1 << 1;
+pub const FLAG_CONSUMED_AKA: i16 = 1 << 2;
+
+#[inline]
+fn tile_id(tile: Tile) -> i16 {
+    let id = tile.deaka().as_u8();
+    if id < TILE_NONE as u8 {
+        id as i16
+    } else {
+        TILE_NONE
+    }
+}
+
+#[inline]
+fn tile_flags(tile: Tile) -> i16 {
+    if tile.is_aka() { FLAG_AKA } else { 0 }
+}
+
+#[inline]
+fn consumed_flags(consumed: &[Tile]) -> i16 {
+    if consumed.iter().copied().any(Tile::is_aka) {
+        FLAG_CONSUMED_AKA
+    } else {
+        0
+    }
+}
+
+#[inline]
+#[must_use]
+pub const fn event_type_id(ev: &Event) -> i16 {
+    match ev {
+        Event::None => TYPE_NONE,
+        Event::StartGame { .. } => TYPE_START_GAME,
+        Event::StartKyoku { .. } => TYPE_START_KYOKU,
+        Event::Tsumo { .. } => TYPE_TSUMO,
+        Event::Dahai { .. } => TYPE_DAHAI,
+        Event::Chi { .. } => TYPE_CHI,
+        Event::Pon { .. } => TYPE_PON,
+        Event::Daiminkan { .. } => TYPE_DAIMINKAN,
+        Event::Kakan { .. } => TYPE_KAKAN,
+        Event::Ankan { .. } => TYPE_ANKAN,
+        Event::Dora { .. } => TYPE_DORA,
+        Event::Reach { .. } => TYPE_REACH,
+        Event::ReachAccepted { .. } => TYPE_REACH_ACCEPTED,
+        Event::Hora { .. } => TYPE_HORA,
+        Event::Ryukyoku { .. } => TYPE_RYUKYOKU,
+        Event::EndKyoku => TYPE_END_KYOKU,
+        Event::EndGame => TYPE_END_GAME,
+    }
+}
+
+/// Encode one public event into a `(type_id, tile, actor, turn, flags)` token.
+#[must_use]
+pub fn encode_event_token(ev: &Event, turn: i16) -> [i16; EVENT_TOKEN_DIM] {
+    match ev {
+        Event::None => [TYPE_NONE, TILE_NONE, ACTOR_NONE, turn, 0],
+
+        Event::StartGame { .. } => [TYPE_START_GAME, TILE_NONE, ACTOR_NONE, turn, 0],
+
+        // Only the public dora marker is emitted; `tehais` stays private.
+        Event::StartKyoku { dora_marker, .. } => [
+            TYPE_START_KYOKU,
+            tile_id(*dora_marker),
+            ACTOR_NONE,
+            turn,
+            tile_flags(*dora_marker),
+        ],
+
+        Event::Tsumo { actor, pai } => [
+            TYPE_TSUMO,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai),
+        ],
+
+        Event::Dahai {
+            actor,
+            pai,
+            tsumogiri,
+        } => [
+            TYPE_DAHAI,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai) | if *tsumogiri { FLAG_TSUMOGIRI } else { 0 },
+        ],
+
+        Event::Chi {
+            actor,
+            pai,
+            consumed,
+            ..
+        } => [
+            TYPE_CHI,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai) | consumed_flags(consumed),
+        ],
+
+        Event::Pon {
+            actor,
+            pai,
+            consumed,
+            ..
+        } => [
+            TYPE_PON,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai) | consumed_flags(consumed),
+        ],
+
+        Event::Daiminkan {
+            actor,
+            pai,
+            consumed,
+            ..
+        } => [
+            TYPE_DAIMINKAN,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai) | consumed_flags(consumed),
+        ],
+
+        Event::Kakan {
+            actor,
+            pai,
+            consumed,
+        } => [
+            TYPE_KAKAN,
+            tile_id(*pai),
+            *actor as i16,
+            turn,
+            tile_flags(*pai) | consumed_flags(consumed),
+        ],
+
+        Event::Ankan { actor, consumed } => [
+            TYPE_ANKAN,
+            tile_id(consumed[0]),
+            *actor as i16,
+            turn,
+            tile_flags(consumed[0]) | consumed_flags(consumed),
+        ],
+
+        Event::Dora { dora_marker } => [
+            TYPE_DORA,
+            tile_id(*dora_marker),
+            ACTOR_NONE,
+            turn,
+            tile_flags(*dora_marker),
+        ],
+
+        Event::Reach { actor } => [TYPE_REACH, TILE_NONE, *actor as i16, turn, 0],
+
+        Event::ReachAccepted { actor } => {
+            [TYPE_REACH_ACCEPTED, TILE_NONE, *actor as i16, turn, 0]
+        }
+
+        Event::Hora { actor, .. } => [TYPE_HORA, TILE_NONE, *actor as i16, turn, 0],
+
+        Event::Ryukyoku { .. } => [TYPE_RYUKYOKU, TILE_NONE, ACTOR_NONE, turn, 0],
+
+        Event::EndKyoku => [TYPE_END_KYOKU, TILE_NONE, ACTOR_NONE, turn, 0],
+
+        Event::EndGame => [TYPE_END_GAME, TILE_NONE, ACTOR_NONE, turn, 0],
+    }
+}
+
+/// Encode a whole public event log (as seen by the arena board / a dataset
+/// kyoku) into a `(T, 5) i16` array. `pov` only affects the `turn` column.
+#[must_use]
+pub fn encode_event_log(log: &[EventExt], pov: u8) -> Array2<i16> {
+    let len = log.len().min(MAX_EVENT_TOKENS);
+    let mut flat = Vec::with_capacity(len * EVENT_TOKEN_DIM);
+    let mut turn = 0_i16;
+
+    for ev in log.iter().take(len) {
+        if let Event::Tsumo { actor, .. } = ev.event {
+            if actor == pov {
+                turn += 1;
+            }
+        }
+        flat.extend_from_slice(&encode_event_token(&ev.event, turn));
+    }
+
+    Array2::from_shape_vec((len, EVENT_TOKEN_DIM), flat)
+        .expect("event token buffer length is a multiple of EVENT_TOKEN_DIM")
+}
